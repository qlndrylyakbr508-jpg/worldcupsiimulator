import csv
import random
import math
import numpy as np
import itertools
from collections import Counter

# ==========================================================
# بخش ۱: کلاس Team (مطابق با ساختار تیم در صورت پروژه)
# ==========================================================
class Team:
    def __init__(self, name, attack, defense, rank):
        self.name = name
        self.attack = int(attack)
        self.defense = int(defense)
        self.rank = int(rank)
        self.reset_stats()

    def goal_difference(self):
        return self.goals_for - self.goals_against

    def reset_stats(self):
        """بازنشانی آمار تیم برای هر بار شبیه‌سازی جدید"""
        self.points = 0
        self.goals_for = 0
        self.goals_against = 0
        self.wins = 0
        self.draws = 0
        self.losses = 0

    def __repr__(self):
        return f"{self.name:<15} | Pts: {self.points:<2} | GD: {self.goal_difference():<3} | GF: {self.goals_for:<2}"

# ==========================================================
# بخش ۲: کلاس Match (مدیریت بازی‌ها و ضربات پنالتی)
# ==========================================================
class Match:
    def __init__(self, team1, team2, is_knockout=False):
        self.team1 = team1
        self.team2 = team2
        self.is_knockout = is_knockout
        self.goals1 = 0
        self.goals2 = 0
        self.winner = None

    def play(self):
        """شبیه‌سازی بازی با استفاده از توزیع پواسون (Poisson Distribution)"""
        # نرخ میانگین گلزنی بر اساس قدرت حمله و دفاع حریف
        lambda1 = (self.team1.attack / self.team2.defense) * 1.5
        lambda2 = (self.team2.attack / self.team1.defense) * 1.5
        
        self.goals1 = np.random.poisson(lambda1)
        self.goals2 = np.random.poisson(lambda2)

        if not self.is_knockout:
            # اعمال نتایج در جدول گروهی
            self.update_group_stats()
        else:
            # مدیریت مساوی در مراحل حذفی
            if self.goals1 > self.goals2:
                self.winner = self.team1
            elif self.goals2 > self.goals1:
                self.winner = self.team2
            else:
                self.simulate_extra_time()

    def update_group_stats(self):
        """به‌روزرسانی امتیازات و تفاضل گل در مرحله گروهی"""
        self.team1.goals_for += self.goals1
        self.team1.goals_against += self.goals2
        self.team2.goals_for += self.goals2
        self.team2.goals_against += self.goals1
        
        if self.goals1 > self.goals2:
            self.team1.points += 3; self.team1.wins += 1; self.team2.losses += 1
        elif self.goals2 > self.goals1:
            self.team2.points += 3; self.team2.wins += 1; self.team1.losses += 1
        else:
            self.team1.points += 1; self.team2.points += 1
            self.team1.draws += 1; self.team2.draws += 1

    def simulate_extra_time(self):
        """شبیه‌سازی وقت‌های اضافه (در صورت تساوی در مرحله حذفی)"""
        extra_lambda1 = (self.team1.attack / self.team2.defense) * 0.3
        extra_lambda2 = (self.team2.attack / self.team1.defense) * 0.3
        self.goals1 += np.random.poisson(extra_lambda1)
        self.goals2 += np.random.poisson(extra_lambda2)
        
        if self.goals1 > self.goals2:
            self.winner = self.team1
        elif self.goals2 > self.goals1:
            self.winner = self.team2
        else:
            self.simulate_penalties()

    def simulate_penalties(self):
        """شبیه‌سازی ضربات پنالتی (Sudden Death)"""
        p1, p2 = 0.75, 0.75 # شانس گل شدن هر پنالتی
        sc1, sc2 = 0, 0
        # ۵ پنالتی اول
        for _ in range(5):
            if random.random() < p1: sc1 += 1
            if random.random() < p2: sc2 += 1
        
        # در صورت تساوی، مرگ ناگهانی
        while sc1 == sc2:
            if random.random() < p1: sc1 += 1
            if random.random() < p2: sc2 += 1
            
        self.winner = self.team1 if sc1 > sc2 else self.team2

# ==========================================================
# بخش ۳: کلاس Group (مدیریت گروه‌ها و رده‌بندی)
# ==========================================================
class Group:
    def __init__(self, name, teams):
        self.name = name
        self.teams = teams

    def play_all_matches(self, verbose=False):
        """برگزاری تمام ترکیبات بازی‌ها در گروه (Round Robin)"""
        if verbose: print(f"\n--- بازی‌های گروه {self.name} ---")
        for t1, t2 in itertools.combinations(self.teams, 2):
            m = Match(t1, t2)
            m.play()
            if verbose: print(f"{t1.name} {m.goals1} - {m.goals2} {t2.name}")

    def get_ranking(self):
        """رده‌بندی تیم‌ها بر اساس امتیاز، تفاضل گل و گل زده"""
        self.teams.sort(key=lambda t: (t.points, t.goal_difference(), t.goals_for), reverse=True)
        return self.teams

# ==========================================================
# بخش ۴: کنترل‌کننده اصلی مسابقات (Tournament Controller)
# ==========================================================
class WorldCupSimulator:
    def __init__(self, csv_file):
        self.csv_file = csv_file
        self.all_teams = []

    def load_teams(self):
        """خواندن اطلاعات تیم‌ها از فایل CSV"""
        self.all_teams = []
        try:
            with open(self.csv_file, mode='r', encoding='utf-8') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    self.all_teams.append(Team(row['name'], row['attack'], row['defense'], row['rank']))
            print(f"✅ {len(self.all_teams)} تیم بارگذاری شدند.")
        except Exception as e:
            print(f"❌ خطا در خواندن فایل: {e}")

    def run_simulation(self, verbose=True):
        """یک بار شبیه‌سازی کامل از گروهی تا فینال"""
        if not self.all_teams: return None
        for t in self.all_teams: t.reset_stats()

        # ۱. قرعه‌کشی (سیدبندی ساده بر اساس رتبه)
        sorted_teams = sorted(self.all_teams, key=lambda x: x.rank)
        pots = [sorted_teams[i:i+8] for i in range(0, 32, 8)]
        for p in pots: random.shuffle(p)
        groups = [Group(chr(65+i), [pots[j][i] for j in range(4)]) for i in range(8)]

        # ۲. مرحله گروهی
        top_teams = []
        for g in groups:
            g.play_all_matches(verbose=verbose)
            ranked = g.get_ranking()
            top_teams.append(ranked)
            if verbose:
                print(f"\n📊 جدول نهایی گروه {g.name}:")
                for i, t in enumerate(ranked, 1): print(f"{i}. {t}")

        # ۳. چیدمان مرحله حذفی (تیم اول گروه A با دوم گروه B و...)
        knockout_teams = []
        pairs = [(0, 1), (2, 3), (4, 5), (6, 7)]
        for g1, g2 in pairs:
            knockout_teams.append(top_teams[g1][0]); knockout_teams.append(top_teams[g2][1])
            knockout_teams.append(top_teams[g2][0]); knockout_teams.append(top_teams[g1][1])

        # ۴. اجرای مراحل حذفی
        current_round = knockout_teams
        stages = ["یک‌هشتم نهایی", "یک‌چهارم نهایی", "نیمه‌نهایی", "فینال"]
        for stage in stages:
            if verbose: print(f"\n⚽ مرحله {stage}:")
            winners = []
            for i in range(0, len(current_round), 2):
                m = Match(current_round[i], current_round[i+1], is_knockout=True)
                m.play()
                if verbose: print(f"{m.team1.name} {m.goals1} - {m.goals2} {m.team2.name} -> صعود: {m.winner.name}")
                winners.append(m.winner)
            current_round = winners
        
        if verbose: print(f"\n🏆 قهرمان: {current_round[0].name}")
        return current_round[0]

    def run_multiple_simulations(self, n=1000):
        """شبیه‌سازی مونت‌کارلو برای پیش‌بینی قهرمان (بخش آماری پروژه)"""
        if not self.all_teams: return
        results = Counter()
        print(f"🔄 در حال اجرای {n} شبیه‌سازی برای استخراج آمار...")
        for _ in range(n):
            winner = self.run_simulation(verbose=False)
            results[winner.name] += 1
        
        print(f"\n📈 شانس قهرمانی ۱۰ تیم برتر:")
        for team, count in results.most_common(10):
            print(f"{team:<15}: {count/n*100:>5.2f}%")

# ==========================================================
# منوی کاربری
# ==========================================================
def main():
    sim = WorldCupSimulator('teams_2026_worldcup.csv')
    while True:
        print("\n=== سیستم شبیه‌ساز جام جهانی 2026 ===")
        print("1. بارگذاری داده‌های تیم‌ها (CSV)")
        print("2. اجرای یک شبیه‌سازی کامل (با گزارش بازی‌ها)")
        print("3. پیش‌بینی قهرمان (اجرای ۱۰۰۰ شبیه‌سازی)")
        print("4. خروج")
        choice = input("انتخاب شما: ")
        
        if choice == '1': sim.load_teams()
        elif choice == '2': sim.run_simulation(verbose=True)
        elif choice == '3': sim.run_multiple_simulations(1000)
        elif choice == '4': break
        else: print("گزینه نامعتبر!")

if __name__ == "__main__":
    main()

input()
